# Core project text files
include AUTHORS
include LICENSE
include README.md

# Browser splash only — not full docs/, sponsors, examples, or scripts
include docs/static/logo.png

# Exclude dev / repo-only trees from sdist and wheel
prune tests
prune .github
prune examples
prune scripts
prune docs/static/sponsors
exclude .gitignore

# Global exclusions
global-exclude *.py[cod] __pycache__ *.so *.dylib .DS_Store
